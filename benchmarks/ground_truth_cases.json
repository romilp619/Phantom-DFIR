      "expected_findings": [
        {
          "id": "subject_srv_service",
          "weight": 20,
          "required": true,
          "aliases": ["subject_srv.exe"],
          "description": "Malicious service binary from C:\\windows\\ rather than System32."
        },
        {
          "id": "c2_172_16_4_10",
          "weight": 20,
          "required": true,
          "aliases": ["172.16.4.10", "172.16.4.10:8080"],
          "description": "C2 connection to attacker host."
        },
        {
          "id": "putty_lateral_movement",
          "weight": 20,
          "required": true,
          "aliases": ["putty.exe", "PuTTY"],
          "description": "PuTTY used for lateral SSH movement."
