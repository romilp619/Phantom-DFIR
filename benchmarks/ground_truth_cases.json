{
  "schema_version": "1.0",
  "description": "PHANTOM DFIR multi-case ground truth and reproduction checklist built from the validated challenge runs.",
  "scoring_notes": [
    "Each finding is considered reproduced when any alias appears in the report text or structured JSON.",
    "Required findings are weighted; optional findings document useful context but do not block a pass.",
    "Forbidden phrases identify common false positives or stale routing bugs seen during validation.",
    "This file is intentionally artifact-driven: it does not require hardcoded answers in PHANTOM itself."
  ],
  "cases": [
    {
