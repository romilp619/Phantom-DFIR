          "required": false,
          "aliases": ["vmtoolsd.exe", "VMware Tools"],
          "description": "VMware tooling treated as benign context."
        }
      ],
      "forbidden": [
        "ruby.exe -- CRITICAL",
        "ruby.exe - malicious"
      ]
    },
